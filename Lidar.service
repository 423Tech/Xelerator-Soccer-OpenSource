[Unit]
Description=Xelerator Service
After=network.target nss-lookup.target
Wants=network.target

[Service]
User=root
Group=root
Type=simple
LimitAS=infinity
LimitRSS=infinity
LimitCORE=infinity
LimitNOFILE=999999
WorkingDirectory=/xel
ExecStart=/bin/bash -c "source ~/.bashrc && export ROS_DOMAIN_ID=99 && python3 /xel/1919810.py"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
